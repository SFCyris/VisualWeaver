# VisualWeaver — Docker Compose settings. `./docker.sh up` writes a `.env` with these;
# `docker compose` reads it automatically. Copy to `.env` to set them by hand.

# Storage: redis (default) | mongodb | both
COMPOSE_PROFILES=redis

# Port on this machine for the web UI (the app listens on 8420 inside the container).
VISUALWEAVER_WEB_PORT=8420

# Who can open the web UI: 0.0.0.0 = any device on the network (default; there is no
# login), 127.0.0.1 = this machine only.
#VISUALWEAVER_WEB_BIND=127.0.0.1

# Required once for the mongodb and both choices: you accept MongoDB's licence
# (Server Side Public License v1, https://www.mongodb.com/licensing/server-side-public-license).
#VISUALWEAVER_ACCEPT_MONGODB_LICENSE=1

# Host names browsers may use to reach VisualWeaver, besides IP addresses, localhost and
# names ending in .local / .lan / .internal / .home.arpa (comma-separated; *.example.com
# matches subdomains). ./docker.sh adds this machine's DNS name.
#VISUALWEAVER_ALLOWED_HOSTS=vw.example.com

# Where Ollama is, seen from the container (default: Ollama on this machine).
#VISUALWEAVER_OLLAMA_URL=http://host.docker.internal:11434

# Upper bound for Redis memory (the redis and both choices).
#VISUALWEAVER_REDIS_MAXMEMORY=2gb
